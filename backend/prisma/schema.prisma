// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Core Enums
enum Language {
  EN
  SR
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum FarmStatus {
  ACTIVE
  ARCHIVED
}

// Core Models
model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  username            String?        @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  language            Language       @default(SR)
  timezone            String         @default("Europe/Belgrade")
  isEmailVerified     Boolean        @default(false)
  isPhoneVerified     Boolean        @default(false)
  isActive            Boolean        @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  farmsCreated        Farm[]         @relation("FarmCreator")
  sentInvitations     FarmMember[]   @relation("InvitationSender")
  operationsCreated   Operation[]    @relation("OperationCreator")
  operationsCompleted Operation[]    @relation("OperationCompleter")
  memberships         FarmMember[]
  refreshTokens       RefreshToken[]
  photosUploaded      Photo[]

  @@index([lastName])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  code        String       @unique
  displayName String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     FarmMember[]

  @@map("roles")
}

model FarmMember {
  id          String           @id @default(uuid())
  farmId      String
  userId      String
  roleId      String
  status      MembershipStatus @default(ACTIVE)
  invitedById String?
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   User?            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([farmId, userId])
  @@index([farmId])
  @@index([userId])
  @@map("farm_members")
}

model Farm {
  id                 String       @id @default(uuid())
  name               String
  registrationNumber String?
  taxNumber          String?
  country            String
  city               String
  address            String?
  postalCode         String?
  latitude           Decimal?     @db.Decimal(9, 6)
  longitude          Decimal?     @db.Decimal(9, 6)
  status             FarmStatus   @default(ACTIVE)
  description        String?
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  createdBy          User         @relation("FarmCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members            FarmMember[]
  fields             Field[]
  photos             Photo[]

  @@index([createdById])
  @@index([name])
  @@map("farms")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Field Enums
enum OwnershipType {
  OWNED
  LEASED
  BORROWED
}

enum FieldStatus {
  ACTIVE
  INACTIVE
}

enum BoundarySource {
  MANUAL
  GPS
  GEOSERBIA
  DRONE
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  HARVESTED
  CLOSED
}

// Field Models
model Field {
  id                    String          @id @default(uuid())
  farmId                String
  name                  String
  parcelNumber          String
  cadastralMunicipality String
  municipality          String?
  area                  Decimal         @db.Decimal(10, 4)
  cultivableArea        Decimal?        @db.Decimal(10, 4)
  soilType              String?
  ownership             OwnershipType
  status                FieldStatus     @default(ACTIVE)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?
  farm                  Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  boundaries            FieldBoundary[]
  seasons               Season[]
  photos                Photo[]

  @@unique([farmId, parcelNumber])
  @@index([farmId])
  @@index([parcelNumber])
  @@index([cadastralMunicipality])
  @@map("fields")
}

model FieldBoundary {
  id             String         @id @default(uuid())
  fieldId        String
  name           String?
  geometry       Json
  areaCalculated Decimal?       @db.Decimal(10, 4)
  source         BoundarySource
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  field          Field          @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@map("field_boundaries")
}

model Crop {
  id          String    @id @default(uuid())
  name        String    @unique
  latinName   String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  seasons     Season[]
  varieties   Variety[]

  @@map("crops")
}

model Company {
  id        String    @id @default(uuid())
  name      String    @unique
  logoUrl   String?
  website   String?
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  varieties Variety[]
  products  Product[]

  @@map("companies")
}

model Variety {
  id            String    @id @default(uuid())
  cropId        String
  companyId     String
  name          String
  fao           String?
  maturityGroup String?
  isActive      Boolean   @default(true)
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  crop          Crop      @relation(fields: [cropId], references: [id], onDelete: Restrict)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  seasons       Season[]

  @@unique([companyId, name])
  @@index([cropId])
  @@map("varieties")
}

model Season {
  id           String       @id @default(uuid())
  fieldId      String
  cropId       String
  varietyId    String?
  year         Int
  plannedArea  Decimal?     @db.Decimal(10, 4)
  actualArea   Decimal?     @db.Decimal(10, 4)
  status       SeasonStatus @default(PLANNED)
  seasonNumber Int          @default(1)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  field        Field        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  crop         Crop         @relation(fields: [cropId], references: [id], onDelete: Restrict)
  variety      Variety?     @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  operations   Operation[]
  photos       Photo[]

  @@unique([fieldId, year, seasonNumber])
  @@index([year])
  @@index([cropId])
  @@map("seasons")
}

// Operation Enums
enum OperationType {
  SOIL_PREPARATION
  SOWING
  FERTILIZATION
  SPRAYING
  IRRIGATION
  HARVEST
  OTHER
}

enum OperationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IrrigationMethod {
  DRIP
  SPRINKLER
  FLOOD
  OTHER
}

// Operation Models
model Operation {
  id              String           @id @default(uuid())
  seasonId        String
  createdById     String
  completedById   String?
  type            OperationType
  status          OperationStatus  @default(PLANNED)
  performedAt     DateTime?
  plannedAt       DateTime?
  durationMinutes Int?
  cost            Decimal?         @db.Decimal(12, 2)
  order           Int?
  isLocked        Boolean          @default(false)
  note            String?
  weatherNote     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  season          Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("OperationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy     User?            @relation("OperationCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  sowing          Sowing?
  fertilization   Fertilization?
  spraying        Spraying?
  irrigation      Irrigation?
  harvest         Harvest?
  soilPreparation SoilPreparation?
  photos          Photo[]

  @@index([seasonId])
  @@index([plannedAt])
  @@index([performedAt])
  @@index([type])
  @@map("operations")
}

model Sowing {
  operationId String    @id
  seedLot     String?
  seedRate    Decimal?  @db.Decimal(10, 2)
  rowSpacing  Decimal?  @db.Decimal(10, 2)
  sowingDepth Decimal?  @db.Decimal(10, 2)
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("sowings")
}

model SoilPreparation {
  operationId   String    @id
  implementName String?
  workingDepth  Decimal?  @db.Decimal(10, 2)
  passes        Int?
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("soil_preparations")
}

model Irrigation {
  operationId     String           @id
  method          IrrigationMethod
  waterAmount     Decimal?         @db.Decimal(10, 2)
  durationMinutes Int?
  operation       Operation        @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("irrigations")
}

model Harvest {
  operationId String    @id
  yieldPerHa  Decimal?  @db.Decimal(10, 2)
  totalYield  Decimal?  @db.Decimal(10, 2)
  moisture    Decimal?  @db.Decimal(5, 2)
  hectoliter  Decimal?  @db.Decimal(5, 2)
  protein     Decimal?  @db.Decimal(5, 2)
  impurities  Decimal?  @db.Decimal(5, 2)
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("harvests")
}

model Fertilization {
  operationId String              @id
  operation   Operation           @relation(fields: [operationId], references: [id], onDelete: Cascade)
  items       FertilizationItem[]

  @@map("fertilizations")
}

model FertilizationItem {
  id              String        @id @default(uuid())
  fertilizationId String
  fertilizerId    String
  quantity        Decimal       @db.Decimal(10, 2)
  unit            Unit
  unitPrice       Decimal?      @db.Decimal(10, 2)
  fertilization   Fertilization @relation(fields: [fertilizationId], references: [operationId], onDelete: Cascade)
  fertilizer      Fertilizer    @relation(fields: [fertilizerId], references: [id], onDelete: Restrict)

  @@map("fertilization_items")
}

model Spraying {
  operationId String         @id
  waterAmount Decimal?       @db.Decimal(10, 2)
  temperature Decimal?       @db.Decimal(5, 2)
  humidity    Decimal?       @db.Decimal(5, 2)
  windSpeed   Decimal?       @db.Decimal(5, 2)
  operation   Operation      @relation(fields: [operationId], references: [id], onDelete: Cascade)
  items       SprayingItem[]

  @@map("sprayings")
}

model SprayingItem {
  id         String   @id @default(uuid())
  sprayingId String
  chemicalId String
  dose       Decimal  @db.Decimal(10, 2)
  unit       Unit
  unitPrice  Decimal? @db.Decimal(10, 2)
  spraying   Spraying @relation(fields: [sprayingId], references: [operationId], onDelete: Cascade)
  chemical   Chemical @relation(fields: [chemicalId], references: [id], onDelete: Restrict)

  @@map("spraying_items")
}

// Product Enums
enum Unit {
  KG
  G
  T

  L
  ML

  PCS
}

enum ProductType {
  FERTILIZER
  CHEMICAL
  SEED
  BIOSTIMULANT
  ADDITIVE
  OTHER
}

enum ProductCategory {
  SOLID
  LIQUID
  GAS
  OTHER
}

enum ChemicalType {
  HERBICIDE
  INSECTICIDE
  FUNGICIDE
  ACARICIDE
  GROWTH_REGULATOR
  OTHER
}

// Product Models
model Product {
  id                 String           @id @default(uuid())
  name               String
  code               String?          @unique
  type               ProductType
  category           ProductCategory?
  manufacturerId     String?
  registrationNumber String?
  activeIngredient   String?
  description        String?
  unit               Unit?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  manufacturer       Company?         @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  fertilizers        Fertilizer[]
  chemicals          Chemical[]

  @@index([type])
  @@index([manufacturerId])
  @@map("products")
}

model Fertilizer {
  id         String              @id @default(uuid())
  productId  String
  nitrogen   Decimal?            @db.Decimal(5, 2)
  phosphorus Decimal?            @db.Decimal(5, 2)
  potassium  Decimal?            @db.Decimal(5, 2)
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  items      FertilizationItem[]

  @@map("fertilizers")
}

model Chemical {
  id              String         @id @default(uuid())
  productId       String
  type            ChemicalType
  activeSubstance String?
  concentration   String?
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  items           SprayingItem[]

  @@map("chemicals")
}

// Photo Enums
enum PhotoEntityType {
  FARM
  FIELD
  SEASON
  OPERATION
}

// Photo Models
model Photo {
  id           String     @id @default(uuid())
  farmId       String?
  fieldId      String?
  seasonId     String?
  operationId  String?
  url          String
  storagePath  String
  fileName     String?
  mimeType     String?
  size         Int?
  description  String?
  uploadedById String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  farm         Farm?      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  field        Field?     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  season       Season?    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  operation    Operation? @relation(fields: [operationId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([farmId])
  @@index([fieldId])
  @@index([seasonId])
  @@index([operationId])
  @@map("photos")
}
